            [InlineKeyboardButton(text="⬅️ Назад", callback_data="main")]
        ])
    )
    await cb.answer()

@dp.callback_query(F.data.startswith("buy:"))
async def buy(cb: CallbackQuery):
    pid = cb.data.split(":")[1]
    if pid not in PRODUCTS:
        await cb.answer("Товар не найден", show_alert=True)
        return
    await send_stars_invoice(cb.from_user.id, pid, cb.from_user.id)
    await cb.answer()

# ===== ОПЛАТА =====
@dp.pre_checkout_query()
async def pre_checkout(q: PreCheckoutQuery):
    await q.answer(ok=True)

@dp.message(F.successful_payment)
async def on_paid(msg: Message):
    payment = msg.successful_payment
    parts = payment.invoice_payload.split(":")
    pid = parts[1]
    buyer_id = int(parts[2])
    amount = payment.total_amount

    p = PRODUCTS.get(pid)
    if not p:
        await msg.answer("Ошибка: товар не найден. Напишите в поддержку.")
        return

    await save_purchase(buyer_id, pid, amount, payment.telegram_payment_charge_id)

    await msg.answer(
        f"✅ Спасибо за покупку!\n\n"
        f"<b>{p['name']}</b>\n"
        f"Ваша ссылка:\n{p['link']}",
        reply_markup=main_menu()
    )

    user = await get_user(buyer_id)
    if user and user[2] and user[3] == 0:
        referrer_id = user[2]
        reward = max(1, amount // 10)
        await add_stars(referrer_id, reward)
        await mark_ref_rewarded(buyer_id)
        try:
            await bot.send_message(
                referrer_id,
                f"🎉 Ваш реферал совершил покупку!\n"
                f"Вам начислено <b>{reward} ⭐</b> на баланс."
            )
        except Exception:
            pass

    try:
        await bot.send_message(
            ADMIN_ID,
            f"💰 Новая покупка: {p['name']} ({amount} ⭐)\n"
            f"Покупатель: {buyer_id} (@{msg.from_user.username})"
        )
    except Exception:
        pass

    await msg.answer(
        "📢 Загляните в наш канал-магазин — там новинки и акции:",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="Перейти в канал", url=SHOP_CHANNEL)]
        ])
    )

# ===== ЗАПУСК =====
async def main():
    await init_db()
    print("Бот запущен")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
