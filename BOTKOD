        [InlineKeyboardButton(text="🛍 Каталог", callback_data="catalog")],
        [InlineKeyboardButton(text="📢 Наш канал-магазин", url=SHOP_CHANNEL)],
        [InlineKeyboardButton(text="👥 Рефералка", callback_data="ref")],
