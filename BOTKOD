# ===== ИНВОЙС =====
async def send_stars_invoice(chat_id: int, pid: str, buyer_id: int):
    p = PRODUCTS[pid]
    await bot.send_invoice(
        chat_id=chat_id,
        title=p["name"],
        description=f"Цифровой товар: {p['name']}",
        payload=f"order:{pid}:{buyer_id}",
        provider_token="",
        currency="XTR",
        prices=[LabeledPrice(label=p["name"], amount=p["price"])],
        start_parameter=f"buy_{pid}",
        reply_markup=invoice_kb(),
    )

# ===== START =====
@dp.message(CommandStart())
async def start(msg: Message):
    args = msg.text.split()

    referrer_id = None
    if len(args) > 1 and args[1].startswith("ref_"):
        try:
            rid = int(args[1].replace("ref_", ""))
            if rid != msg.from_user.id:
                referrer_id = rid
        except ValueError:
            pass

    user = await get_user(msg.from_user.id)
    if not user:
        await create_user(msg.from_user.id, msg.from_user.username or "", referrer_id)
        user = await get_user(msg.from_user.id)

    balance = user[4] if user else 0

    if len(args) > 1 and args[1].startswith("buy_"):
        pid = args[1].replace("buy_", "")
        if pid in PRODUCTS:
            await msg.answer(
                f"👋 Открываем оплату: <b>{PRODUCTS[pid]['name']}</b> за "
                f"<b>{PRODUCTS[pid]['price']} ⭐</b>"
            )
            await send_stars_invoice(msg.chat.id, pid, msg.from_user.id)
            return

    await msg.answer(
        f"👋 Добро пожаловать в <b>магазин</b>!\n\n"
        f"💰 Ваш баланс: <b>{balance} ⭐</b>\n"
        f"Оплата в Telegram Stars. Приглашайте друзей — получайте 10% с их покупок!",
        reply_markup=main_menu()
    )

# ===== МЕНЮ =====
@dp.callback_query(F.data == "main")
async def main_cb(cb: CallbackQuery):
    await cb.message.edit_text("Главное меню:", reply_markup=main_menu())
    await cb.answer()

@dp.callback_query(F.data == "catalog")
async def catalog(cb: CallbackQuery):
    await cb.message.edit_text("🛍 <b>Каталог:</b>", reply_markup=catalog_kb())
    await cb.answer()

@dp.callback_query(F.data.startswith("view:"))
async def view(cb: CallbackQuery):
    pid = cb.data.split(":")[1]
    p = PRODUCTS[pid]
    await cb.message.edit_text(
        f"<b>{p['name']}</b>\n\n💰 Цена: <b>{p['price']} ⭐</b>",
        reply_markup=product_kb(pid)
    )
    await cb.answer()

@dp.callback_query(F.data == "ref")
async def show_ref(cb: CallbackQuery):
    me = await bot.get_me()
    link = f"https://t.me/{me.username}?start=ref_{cb.from_user.id}"

    rewarded_count = 0
    async with aiosqlite.connect(DB_PATH) as db:
        async with db.execute(
            "SELECT COUNT(*) FROM users WHERE referrer_id=? AND ref_rewarded=1",
            (cb.from_user.id,)
        ) as cur:
            row = await cur.fetchone()
            rewarded_count = row[0] if row else 0

    await cb.message.edit_text(
        f"👥 <b>Реферальная программа</b>\n\n"
        f"Приглашайте друзей по ссылке:\n<code>{link}</code>\n\n"
        f"Вы получаете <b>10%</b> от суммы их первой покупки в звёздах ⭐\n\n"
        f"✅ Приведено рефералов (с покупкой): <b>{rewarded_count}</b>",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="⬅️ Назад", callback_data="main")]
        ])
    )
    await cb.answer()

@dp.callback_query(F.data == "balance")
async def show_balance(cb: CallbackQuery):
    user = await get_user(cb.from_user.id)
    bal = user[4] if user else 0
    await cb.message.edit_text(
        f"💰 <b>Ваш баланс:</b> {bal} ⭐\n\n"
